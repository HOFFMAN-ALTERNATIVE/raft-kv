.PHONY: test race chaos lint bench build up e2e down
test:  ; go test -count=1 ./...
race:  ; go test -race -count=1 -shuffle=on ./...
lint:  ; go vet ./... && golangci-lint run ./...
bench: ; go test -run xxx -bench . -benchmem ./raft/
build: ; CGO_ENABLED=0 go build -trimpath -o bin/ ./cmd/...
up:    ; docker compose up -d --build
e2e:   ; ./scripts/chaos.sh
down:  ; docker compose down -v
